---
import ApiShowcaseAnimation from "../react/animation/ApiShowcaseAnimation.jsx";

const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000';

const API_DISPLAY = API_URL.replace(/^https?:\/\//, '');


const codeContent = `<span class="text-purple-400">POST</span> <span class="text-blue-400">/predict</span> HTTP/1.1
<span class="text-purple-400">Host:</span> ${API_DISPLAY}
<span class="text-purple-400">Content-Type:</span> application/json

<span class="text-gray-500">// Response</span>
{
  <span class="text-yellow-400">"status"</span>: <span class="text-green-400">true</span>,
  <span class="text-yellow-400">"message"</span>: <span class="text-green-400">"Prediksi curah hujan berhasil diambil"</span>,
  <span class="text-yellow-400">"data"</span>: [
    {
      <span class="text-yellow-400">"location"</span>: <span class="text-green-400">"Gorontalo"</span>,
      <span class="text-yellow-400">"unit"</span>: <span class="text-green-400">"mm/hari"</span>
      <span class="text-yellow-400">"model_used"</span>: <span class="text-green-400">"lstm-v3.2.1"</span>,
      <span class="text-yellow-400">"prediction_start"</span>: <span class="text-blue-400">"2025-07-01"</span>,
      <span class="text-yellow-400">"prediction_end"</span>: <span class="text-blue-400">"2025-07-05"</span>
      <span class="text-yellow-400">"predictions"</span>: [
        {<span class="text-yellow-400">"date"</span>: <span class="text-green-400">"2025-07-01"</span>,<span class="text-yellow-400">"value"</span>: <span class="text-blue-400">2.4</span>},
        {<span class="text-yellow-400">"date"</span>: <span class="text-green-400">"2025-07-02"</span>,<span class="text-yellow-400">"value"</span>: <span class="text-blue-400">0</span>},
        {<span class="text-yellow-400">"date"</span>: <span class="text-green-400">"2025-07-03"</span>,<span class="text-yellow-400">"value"</span>: <span class="text-blue-400">1.7</span>},
        <span class="text-gray-500">...</span>
      ]
    },
  ],
}`;
---
<section id="api" class="mt-24 md:mt-48 mb-24 md:mb-48 py-12 md:py-20 bg-black overflow-hidden">
    <ApiShowcaseAnimation client:load />
    <div class="container mx-auto px-4 md:px-6">
        <div class="flex flex-col lg:flex-row items-center gap-8 lg:gap-0">
            <div class="w-full lg:w-1/2 lg:pr-10 order-1 lg:order-1">
                <h2 class="api-header text-2xl md:text-3xl lg:text-4xl font-bold mb-4 md:mb-6">Integrasi Mudah dengan <span class="gradient-text">OpenAPI LSTM</span></h2>
                <p class="api-header-desc text-gray-400 mb-6 md:mb-8 text-sm md:text-base">
                    Cukup kirim POST request dengan body JSON berisi n_days, dan API kami akan mengembalikan data dalam format JSON yang siap dipakai langsung di aplikasi atau sistem Anda.
                </p>
                <div class="space-y-3 md:space-y-4">
                    <div class="api-feature flex items-start">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 md:h-6 md:w-6 text-blue-400 mt-0.5 md:mt-1 mr-3 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                        <div>
                            <h4 class="font-semibold text-base md:text-lg">Endpoint Simpel</h4>
                            <p class="text-gray-400 text-sm md:text-base">Cukup panggil `/api/v1/predict` untuk mendapatkan data harian sampai 90 hari ke depan.</p>
                        </div>
                    </div>
                    <div class="api-feature flex items-start">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 md:h-6 md:w-6 text-blue-400 mt-0.5 md:mt-1 mr-3 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                        <div>
                            <h4 class="font-semibold text-base md:text-lg">Hanya Format JSON</h4>
                            <p class="text-gray-400 text-sm md:text-base">Mirip BMKG, respons API kami sepenuhnya JSON tanpa pembungkus XML atau CSV.</p>
                        </div>
                    </div>
                    <div class="api-feature flex items-start">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 md:h-6 md:w-6 text-blue-400 mt-0.5 md:mt-1 mr-3 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                        <div>
                            <h4 class="font-semibold text-base md:text-lg">API Dokumentasi Interaktif</h4>
                            <p class="text-gray-400 text-sm md:text-base">Uji endpoint dan lihat respons langsung di live demo.</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="api-codeblock w-full lg:w-1/2 bg-gray-800 rounded-xl overflow-hidden order-2 lg:order-2">
                <div class="p-3 md:p-4 bg-gray-900 flex items-center">
                    <div class="flex space-x-2 mr-3 md:mr-4">
                        <div class="w-2.5 h-2.5 md:w-3 md:h-3 rounded-full bg-red-500"></div>
                        <div class="w-2.5 h-2.5 md:w-3 md:h-3 rounded-full bg-yellow-500"></div>
                        <div class="w-2.5 h-2.5 md:w-3 md:h-3 rounded-full bg-green-500"></div>
                    </div>
                    <div class="text-xs md:text-sm text-gray-400 truncate">{API_DISPLAY}/predict</div>
                </div>
                <div class="p-4 md:p-6 overflow-x-auto">
                    <pre class="text-green-400 text-xs md:text-sm whitespace-pre-wrap break-words" set:html={codeContent} />
                </div>
            </div>
        </div>
    </div>
</section>


<style>
.btn-primary {
    background: linear-gradient(90deg, #3b82f6, #06b6d4);
    transition: all 0.3s ease;
}
.btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(56, 189, 248, 0.4);
}
</style>