---
import DemoAnimation from "../react/animation/DemoAnimation.jsx";
import DemoSection from "../react/DemoSection.jsx";
---

<section id="demo" class="mt-24 md:mt-48 mb-24 md:mb-48 py-12 md:py-20 bg-gradient-to-b from-black to-black overflow-hidden">
    <DemoAnimation client:load />
    <div class="container mx-auto px-4 md:px-6">
      <div class="demo-header text-center mb-10 md:mb-16">
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold mb-3 md:mb-4">Uji Coba <span class="gradient-text">API Prediksi</span></h2>
        <p class="text-gray-400 max-w-2xl mx-auto text-sm md:text-base px-2">
          Masukkan jumlah hari prediksi untuk wilayah Gorontalo dan lihat langsung respon dari model LSTM kami.
        </p>
      </div>
  
      <DemoSection client:load />
    </div>
</section>
