---
import RainfallChartAnimation from '../react/animation/RainfallChartAnimation';
import ColumnChartSection from '../react/chart/ColumnChartSection.jsx';


---

<section id="last-day-data" class="mt-64 mb-64 py-20 bg-gradient-to-b from-black to-black">
  <RainfallChartAnimation client:load />

  <div class="container max-w-5xl mx-auto px-6">
    <div class="rainfall-chart-container">
        <ColumnChartSection client:load />
    </div>
  </div>
</section>